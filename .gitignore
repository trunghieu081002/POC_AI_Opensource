.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Drafted by the diagnose hook — review, move into errors.yaml, then delete.
packs/*/errors.proposed.yaml

# A validation report, regenerated on every `dpagent pipeline synth`/
# `validate` run - not an artifact to review in a diff, unlike
# .approved.yaml (which stays tracked).
pipelines/*/.synth-validation.yaml

*.db
*.jsonl
*.dpagent-*.bak

# The M2.5 acceptance-suite ledger is deliberately committed evidence, not
# a runtime artifact - the one exception to the blanket *.jsonl rule above.
!docs/evidence/m25-automated/registry.jsonl
