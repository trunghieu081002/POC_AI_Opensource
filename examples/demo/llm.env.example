# Layer 3 (AI) only. Copy OUTSIDE the repository (e.g. ~/.dpagent-llm.env), chmod 600, fill, then load it in the
# shell that runs the demo or the acceptance runner:   set -a; . ~/.dpagent-llm.env; set +a
# Never commit it, never print it, never run with `set -x` while it is loaded.
DPAGENT_MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=
# The request budget, shared by every command, rerun and session that uses it (src/dpagent/llm/ledger.py).
# Create it once:  python -m dpagent.llm.ledger init ~/dpagent-budget/ledger.jsonl probe=2 main=6 asks=6 total=14
# DPAGENT_LLM_LEDGER=/home/<you>/dpagent-budget/ledger.jsonl
