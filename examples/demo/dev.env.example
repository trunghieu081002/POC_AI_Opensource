# Copy to dev.env (never commit it), fill every value, then:  set -a; . ./dev.env; set +a
DEMO_ENVIRONMENT=dev
# demo source (created by the postgres pack, filled from the fulfil fixture by `demo.sh source`)
FS_SRC_HOST=localhost
FS_SRC_PORT=5432
FS_SRC_NAME=fs_source
FS_SRC_USER=fs_source
FS_SRC_PASSWORD=change-me
# warehouse writer (the standard refs `pipeline synth` gives the model)
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=dbt_user
WAREHOUSE_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
DLT_DB_PASSWORD=change-me
SUPERSET_METADATA_PASSWORD=change-me
SUPERSET_SECRET_KEY=change-me-to-at-least-32-random-characters
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_WAREHOUSE_PASSWORD=change-me
FS_VIEWER_PASSWORD=change-me-viewer
# who approves the pipeline and the dashboard: a person, recorded in the approval (demo.sh stops without it)
DEMO_APPROVED_BY=
DEMO_BI_APPROVED_BY=
# Layer 3 (AI) - only for DEMO_DRAFT=ai (the default): any LiteLLM provider, e.g.
#   DPAGENT_MODEL=gemini/gemini-3.8-flash  GEMINI_API_KEY=...
# Leave unset and use DEMO_DRAFT=reference to rehearse layers 1/2 + BI with the hand-written reference pipeline.
