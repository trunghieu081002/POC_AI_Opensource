# Copy to dev.env (never commit it), fill every value, then:  set -a; . ./dev.env; set +a
# One file per environment (dev.env, test.env, ...); the specs and the pipeline only hold ${VAR} names.
QS_ENVIRONMENT=dev
# demo source (created by the postgres pack, filled by `dpagent pipeline fixture-sql`)
QS_SRC_HOST=localhost
QS_SRC_PORT=5432
QS_SRC_NAME=qs_source
QS_SRC_USER=qs_source
QS_SRC_PASSWORD=change-me
# warehouse writer: the pipeline's dbt/dlt role and the table creator the BI reader follows
QS_WH_HOST=localhost
QS_WH_PORT=5432
QS_WH_NAME=warehouse
QS_WH_USER=dbt_user
QS_WH_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
DLT_DB_PASSWORD=change-me
SUPERSET_METADATA_PASSWORD=change-me
SUPERSET_SECRET_KEY=change-me-to-at-least-32-random-characters
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_WAREHOUSE_PASSWORD=change-me
# who approves the pipeline and the dashboard (a person, recorded in the approval)
QS_APPROVED_BY=your.name
