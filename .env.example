# Copy to .env and fill in. Load with:  set -a; source .env; set +a
# (quote any value containing spaces or shell metacharacters, e.g.
# PG_APP_PASSWORD='a value with spaces' - this file is sourced as shell, not
# parsed as plain key=value)
#
# litellm itself is an optional install - pip install -e '.[llm]' (or
# DPAGENT_WITH_LLM=1 before scripts/bootstrap.sh) - independent of this file.
#
# None of this is needed for `install`, `verify`, `rollback` or `status`.
# A model is only involved in three commands:
#   dpagent do "<plain language>"   routing a request onto packs
#   dpagent synth <tool>            drafting a pack for an unknown tool
#   (automatic)                     diagnosing a failure the catalog missed

# --- provider: pick one -----------------------------------------------------

# Google Gemini — widest free tier, recommended for exercising the flow.
# Key: https://aistudio.google.com/app/apikey
DPAGENT_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=

# Groq — free and fast.
# DPAGENT_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=

# Local, no network, no cost. Needs a GPU or 32GB+ RAM.
# DPAGENT_MODEL=ollama/qwen2.5-coder:32b

# OpenAI
# DPAGENT_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=

# Anthropic — for production pack synthesis, where draft quality matters most.
# DPAGENT_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# --- agent paths (defaults shown) -------------------------------------------

# DPAGENT_DB=/var/lib/dpagent/dpagent.db
# DPAGENT_LOG_DIR=/var/log/dpagent
# DPAGENT_PACKS=/opt/dpagent/packs

# --- secrets referenced by project.yaml -------------------------------------
# A spec never holds a password. It holds ${NAME}, resolved from here.

# PG_APP_PASSWORD=
